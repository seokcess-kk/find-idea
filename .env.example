# ===========================================
# Find Idea - Environment Configuration
# ===========================================

# -------------------------------------------
# AI Provider Settings
# -------------------------------------------
# Available providers: 'ollama' | 'openai'
AI_PROVIDER=ollama

# Enable fallback to secondary provider when primary fails
AI_FALLBACK_ENABLED=false

# -------------------------------------------
# Ollama Settings (Local LLM)
# -------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30000

# -------------------------------------------
# OpenAI Settings
# -------------------------------------------
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30000

# -------------------------------------------
# Reddit API Settings (OAuth2)
# -------------------------------------------
# Create app at: https://www.reddit.com/prefs/apps
# Choose "script" type for personal use
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=find-idea:1.0 (by /u/your_username)

# -------------------------------------------
# Database Settings
# -------------------------------------------
DATABASE_URL=file:./data/find-idea.db
